{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "default_model",
    "default_variant",
    "variants"
  ],
  "properties": {
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "default_model": { "type": "string" },
    "default_variant": { "type": "string" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "messages"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "model": { "type": "string" },
          "vars": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["name", "value_type"],
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "value_type": {
                  "type": "string",
                  "enum": ["string", "text", "boolean", "number", "enum"]
                },
                "choices": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1,
                  "description": "Required when value_type is 'enum'. Lists the allowed values."
                },
                "default_value": {},
                "required": { "type": "boolean", "default": false },
                "minimum": {
                  "type": "number",
                  "description": "Smallest accepted value (inclusive). Only for value_type 'number'."
                },
                "maximum": {
                  "type": "number",
                  "description": "Largest accepted value (inclusive). Only for value_type 'number'."
                }
              },
              "if": {
                "properties": { "value_type": { "const": "enum" } },
                "required": ["value_type"]
              },
              "then": { "required": ["choices"] },
              "else": {
                "properties": { "choices": false }
              },
              "additionalProperties": false
            }
          },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/definitions/message" }
          },
          "steps": {
            "type": "object",
            "description": "Named message lists for agents that ask the model several times. A variant uses either 'messages' or 'steps'.",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/message" }
            }
          }
        },
        "not": {
          "required": ["steps"],
          "properties": {
            "messages": { "minItems": 1 },
            "steps": { "minProperties": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "message": {
      "type": "object",
      "oneOf": [
        {
          "required": ["text"],
          "properties": {
            "role": {
              "type": "string",
              "enum": ["system", "user", "assistant"],
              "default": "user"
            },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["file"],
          "properties": {
            "role": {
              "type": "string",
              "enum": ["system", "user", "assistant"],
              "default": "user"
            },
            "file": {
              "type": "string",
              "description": "Path to an external template file (.jinja, .j2, or .md). Relative paths are resolved from the directory of this YAML file. Absolute paths are used as-is."
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}